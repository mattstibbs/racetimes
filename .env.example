DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=
# Leave unset for SQLite; set for PostgreSQL:
# DATABASE_URL=postgres://user:pass@localhost:5432/racetimes
# Only needed if the site is served from a hostname Render (or similar) does
# not set for you, e.g. a custom domain:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://racetimes.example.org
# Email. Leave EMAIL_HOST unset to print emails to the console instead.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Race Times <results@example.org>
# Clubs (slice 11). Each club is at <subdomain>.<SERVICE_DOMAIN>; in
# development that's e.g. http://demo.localhost:8000/.
# SERVICE_DOMAIN=localhost            (racetimes.co.uk when DJANGO_DEBUG=0)
# The club to show on an address with no club in it (127.0.0.1, or a host
# like onrender.com that can't have subdomains). Unset: the service's own page.
# SINGLE_CLUB=demo
# The first club, created by the migrations and given any data from before
# clubs existed.
# FIRST_CLUB_NAME=Demo Club
# FIRST_CLUB_SUBDOMAIN=demo
# Shown on the service's front page for clubs wanting to use Race Times.
# SERVICE_CONTACT_EMAIL=hello@racetimes.co.uk
# Running in production (slice 11 part 4); see docs/deploying.md.
# How long browsers must use HTTPS (HSTS), in seconds, when DJANGO_DEBUG=0.
# SECURE_HSTS_SECONDS=3600
# How many proxies add to X-Forwarded-For: 0 with none, 1 on Render.
# TRUSTED_PROXIES=0
# Report errors to Sentry. Unset: nothing is sent.
# SENTRY_DSN=https://...@....ingest.sentry.io/...
